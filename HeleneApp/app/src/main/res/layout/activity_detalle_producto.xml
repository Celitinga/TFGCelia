<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F5F2">

    <!-- SCROLL -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/detailImage"
                android:layout_width="match_parent"
                android:layout_height="372dp"
                android:scaleType="centerCrop"
                tools:src="@tools:sample/avatars" />

            <!-- CONTENIDO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LUXURY COLLECTION"
                    android:textColor="#B08B57"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:letterSpacing="0.15"
                    android:paddingBottom="10dp"/>

                <!-- NOMBRE -->
                <TextView
                    android:id="@+id/detailNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nombre del producto"
                    android:textColor="#1E1E1E"
                    android:textStyle="bold"
                    android:textSize="30sp"
                    android:fontFamily="sans-serif-medium"/>

                <!-- PRECIO -->
                <TextView
                    android:id="@+id/detailPrecio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="49.99 €"
                    android:textColor="#C49A6C"
                    android:textStyle="bold"
                    android:textSize="24sp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="24dp"
                    android:background="#E8DED2"/>

                <!-- TITULO DESCRIPCIÓN -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Descripción"
                    android:textColor="#1E1E1E"
                    android:textStyle="bold"
                    android:textSize="18sp"/>

                <!-- DESCRIPCIÓN -->
                <TextView
                    android:id="@+id/detailDescripcion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Descripción del producto..."
                    android:textColor="#666666"
                    android:textSize="15sp"
                    android:lineSpacingExtra="6dp"/>

                <!-- BOTÓN EDITAR -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditar"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="36dp"
                    android:layout_marginBottom="30dp"
                    android:text="Editar producto"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:visibility="gone"
                    android:backgroundTint="#1E1E1E"
                    app:cornerRadius="18dp"/>

                <!-- BOTONES ACCIONES -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="18dp">

                    <!-- VOLVER -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVolver"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:text="Volver"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        android:textColor="#1E1E1E"
                        android:backgroundTint="#E8DED2"
                        app:cornerRadius="18dp"/>

                    <Space
                        android:layout_width="12dp"
                        android:layout_height="wrap_content"/>

                    <!-- COMPRAR -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnComprar"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:text="Comprar"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        android:backgroundTint="#1E1E1E"
                        app:cornerRadius="18dp"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>